# Copy to .env for local overrides (never commit secrets).

# Backend
DATABASE_URL=postgresql+psycopg://gata:gata@localhost:5432/gata
SMTP_HOST=localhost
SMTP_PORT=1025

# Frontend dev proxy (docker-compose sets this for the frontend service)
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_TILES_PROXY_TARGET=http://localhost:8080

# Map (self-hosted PMTiles and basemaps assets via Caddy; see scripts/tiles/)
VITE_MAP_PMTILES_PATH=/tiles/dev-small.pmtiles
VITE_MAP_ASSETS_PREFIX=/tiles/basemaps-assets
VITE_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright